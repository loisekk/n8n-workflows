    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Tool executor - handles scheduled/background tasks\nconst taskType = $input.first().json.taskType || 'default';\nconst payload = $input.first().json.payload || {};\n\nconst results = [];\n\n// Example scheduled tasks\nif (taskType === 'email_check') {\n  // Check for important emails\n  results.push({ task: 'email_check', status: 'completed', summary: 'Checked inbox' });\n} else if (taskType === 'daily_summary') {\n  // Generate daily summary\n  results.push({ task: 'daily_summary', status: 'completed', summary: 'Generated summary' });\n} else if (taskType === 'reminder') {\n  // Process reminder\n  results.push({ task: 'reminder', status: 'completed', reminder: payload.message });\n}\n\nreturn results.map(r => ({ json: r }));"
      },
      "id": "task-executor",
      "name": "Task Executor",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 840]
    },
    {
      "parameters": {},
      "id": "no-operation",
      "name": "No Op",
      "type": "n8n-nodes-base.noOp",
