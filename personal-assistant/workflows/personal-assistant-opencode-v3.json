    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// OpenClaw Gateway - Central Orchestration\nconst channel = $input.first().json.channel || 'unknown';\nconst userId = $input.first().json.userId || $input.first().json.from || 'default';\nconst message = $input.first().json.message || $input.first().json.text || $input.first().json.body || '';\nconst timestamp = new Date().toISOString();\n\n// Normalize message across channels\nconst normalizedInput = {\n  channel: channel,\n  userId: userId,\n  message: message,\n  timestamp: timestamp,\n  raw: $input.first().json\n};\n\nreturn [{ json: normalizedInput }];"
      },
      "id": "gateway-normalizer",
      "name": "OpenCode Normalizer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 560]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "conversations",
        "columns": "user_id, channel, message, timestamp",
        "options": {}
      },
      "id": "memory-store",
      "name": "Memory Store (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [760, 460],
      "credentials": {
        "postgres": {
          "id": "YOUR_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres Memory"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT message, channel, timestamp FROM conversations WHERE user_id = '{{ $json.userId }}' ORDER BY timestamp DESC LIMIT 20",
        "options": {}
      },
      "id": "memory-fetch",
      "name": "Memory Fetch (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [760, 660],
      "credentials": {
        "postgres": {
          "id": "YOUR_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres Memory"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/chat",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "llama3"
            },
            {
              "name": "stream",
              "value": "false"
            },
            {
              "name": "messages",
              "value": "={{ JSON.stringify([{ role: 'system', content: 'You are a helpful personal assistant. You have memory of past conversations. Be concise and helpful.' }, ...($json.history || []).map(h => ({ role: h.channel === 'user' ? 'user' : 'assistant', content: h.message })), { role: 'user', content: $json.message }]) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "ollama-llm",
      "name": "Ollama LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1000, 560]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Parse Ollama response and extract tool calls if any\nconst response = $input.first().json;\nconst assistantMessage = response.message?.content || response.response || 'I could not process that request.';\n\n// Check for tool call patterns\nconst toolPatterns = {\n  'web_search': /search (?:for )?(.+)/i,\n  'calculate': /calculate (.+)/i,\n  'reminder': /remind me (?:to )?(.+)/i,\n  'weather': /weather (?:in )?(.+)/i\n};\n\nlet toolCall = null;\nfor (const [tool, pattern] of Object.entries(toolPatterns)) {\n  const match = assistantMessage.match(pattern);\n  if (match) {\n    toolCall = { tool, args: match[1] };\n    break;\n  }\n}\n\nreturn [{\n  json: {\n    response: assistantMessage,\n    toolCall: toolCall,\n    userId: $input.first().json.userId,\n    channel: $input.first().json.channel\n  }\n}];"
      },
      "id": "response-parser",
      "name": "Response Parser",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1240, 560]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.toolCall }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "tool-router",
      "name": "Tool Router",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1480, 560]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.search.brave.com/res/v1/web/search?q={{ encodeURIComponent($json.toolCall.args) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Subscription-Token",
              "value": "YOUR_BRAVE_API_KEY"
            }
          ]
        },
        "options": {}
      },
      "id": "web-search-tool",
      "name": "Web Search Tool",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1720, 460]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/chat",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "llama3"
            },
            {
              "name": "stream",
              "value": "false"
            },
            {
              "name": "messages",
              "value": "={{ JSON.stringify([{ role: 'system', content: 'Summarize these search results concisely.' }, { role: 'user', content: 'Query: ' + $json.toolCall.args + '\\n\\nResults: ' + JSON.stringify($json.data?.web?.results?.slice(0, 3) || []) }]) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "search-summarizer",
      "name": "Search Summarizer",
